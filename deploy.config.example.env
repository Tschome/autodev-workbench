# Copy this file to deploy.env and edit it. deploy.env is gitignored.
# deploy.sh sources it automatically.

# rclone remote name — must match an entry in `rclone listremotes`.
# Leave empty only when SITE_TARGET is a local path (e.g. testing).
RCLONE_REMOTE=alioss

# Where the website goes: <remote>:<bucket>[/<prefix>]
SITE_TARGET=alioss:autodev-workbench-site

# Optional: host the installers separately, e.g. on an `updates.` domain.
# If you set this, the URLs in release.json must become absolute.
# DL_TARGET=alioss:autodev-workbench-pkgs

# Public base URL of the deployed site — used for the post-deploy smoke test.
SITE_BASE_URL=https://www.example.com
